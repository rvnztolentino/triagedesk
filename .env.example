# Required for TriageDesk AI triage. Runtime submission currently expects Groq.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Required Supabase project settings. Keep the service-role key server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for bootstrapping the protected owner. Signup with this email becomes owner.
SEED_ADMIN_EMAIL=admin@example.com

# Optional outside local/Vercel. Used for Supabase email verification links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required only when attaching request files. The schema creates this private bucket.
SUPABASE_REQUEST_ATTACHMENTS_BUCKET=request-attachments

# Optional but recommended in production. Used to salt stored rate-limit keys.
RATE_LIMIT_SALT=

# Optional. Required only for detailed production /api/health diagnostics.
HEALTHCHECK_TOKEN=

# Required only for the Supabase MCP server (.mcp.json). Personal access token,
# generated per-collaborator at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional Sentry error monitoring.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
