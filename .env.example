# Required for TriageDesk AI triage. Runtime submission currently expects Groq.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional AI triage tuning. Reasoning models spend part of the completion
# budget on hidden reasoning tokens before writing any JSON, so the ceiling has
# to cover reasoning plus the response or Groq rejects the truncated output and
# triage silently degrades to keyword rules. Leave these unset unless you change
# GROQ_MODEL. Set GROQ_REASONING_EFFORT to an empty value to omit the field for
# models that do not accept it (the client also detects this and retries).
GROQ_MAX_COMPLETION_TOKENS=1500
GROQ_REASONING_EFFORT=low

# Required Clerk authentication keys (Dashboard -> API keys). Keep the secret server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required Supabase project settings (database + storage only; auth is handled by
# Clerk). Keep the service-role key server-only. The anon key is no longer needed.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for bootstrapping the protected owner. The Clerk account whose email
# matches this becomes the owner on first sign-in.
SEED_ADMIN_EMAIL=admin@example.com

# Optional outside local/Vercel. Used to build absolute post-auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public support address shown in the landing page contact panel. Leave
# blank and the panel reports that no address is configured. Only set this on a
# deployment that actually wants to receive mail: it is baked into the client
# bundle at build time, so whatever you put here is public and will be scraped.
NEXT_PUBLIC_CONTACT_EMAIL=

# Required only when attaching request files. The schema creates this private bucket.
SUPABASE_REQUEST_ATTACHMENTS_BUCKET=request-attachments

# Required for the live demo (no-account preview). Not fetched from any dashboard:
# you generate this one yourself:
#   openssl rand -hex 32
# Signs the demo session cookie, so keep it server-only and never prefix it with
# NEXT_PUBLIC_. Leaving it blank disables the demo (fail closed: unsigned demo
# cookies would be forgeable). Rotating it ends every live demo session and nothing
# else. Use a different value per environment.
DEMO_SESSION_SECRET=

# Optional kill switch for the live demo. Omit (or leave blank) to keep the demo on.
# Set to the literal string false to turn it off without a deploy.
DEMO_ENABLED=

# Required in production. Salts stored rate-limit identity hashes so the table
# cannot be reversed back into raw IPs and emails. Generate with:
#   openssl rand -hex 32
# Unset, the app falls back to the service-role key. In production it refuses the
# published development salt outright rather than storing guessable hashes.
RATE_LIMIT_SALT=

# Optional. Required only for detailed production /api/health diagnostics.
HEALTHCHECK_TOKEN=

# Required only for the Supabase MCP server (.mcp.json). Personal access token,
# generated per-collaborator at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional Sentry error monitoring.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
